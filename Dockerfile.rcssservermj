FROM python:3.12-slim

ARG RCSSSERVERMJ_REPO=https://github.com/Visual-Analytics-Toolbox/rcssservermj.git
ARG RCSSSERVERMJ_COMMIT=0f61b3e5ecd4d0a1d61eab208af2eb8d2ff70a05

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MUJOCO_GL=egl

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    libegl1 \
    libgl1 \
    libglib2.0-0 \
    libx11-6 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone "$RCSSSERVERMJ_REPO" /opt/rcssservermj \
    && cd /opt/rcssservermj \
    && git checkout "$RCSSSERVERMJ_COMMIT"

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install /opt/rcssservermj

EXPOSE 60000 60001

CMD ["rcssservermj", "--host", "0.0.0.0", "--aport", "60000", "--mport", "60001", "--no-render"]
